# Copy this file to .env for local Docker Compose use.
# Never commit the real .env file if it contains non-local credentials.
POSTGRES_DB=appointment_ops
POSTGRES_USER=appointment_ops
POSTGRES_PASSWORD=appointment_ops

# Spring Boot uses these when the Java service runs directly on the host.
# When the service runs inside Docker, DB_URL should use the postgres service name.
DB_URL=jdbc:postgresql://localhost:5432/appointment_ops
DB_USERNAME=appointment_ops
DB_PASSWORD=appointment_ops
# Set this to false only when deliberately running without a database.
FLYWAY_ENABLED=true
