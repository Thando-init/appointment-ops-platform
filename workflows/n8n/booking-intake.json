{
  "name": "Appointment Ops - Booking Created Intake",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "booking-created",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "booking-webhook",
      "name": "Booking Created Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "appointment-booking-created"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.eventType}}",
              "operation": "equals",
              "value2": "booking.created"
            }
          ],
          "boolean": [
            {
              "value1": "={{!!$json.bookingReference}}",
              "operation": "isTrue"
            }
          ]
        }
      },
      "id": "validate-event",
      "name": "Validate Booking Event",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"accepted\":true,\"bookingReference\":$json.bookingReference}",
        "options": {}
      },
      "id": "accepted-response",
      "name": "Acknowledge Event",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [760, 220]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"accepted\":false,\"reason\":\"Invalid booking event\"}",
        "options": {
          "responseCode": 400
        }
      },
      "id": "rejected-response",
      "name": "Reject Invalid Event",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [760, 400]
    }
  ],
  "connections": {
    "Booking Created Webhook": {
      "main": [[{"node": "Validate Booking Event", "type": "main", "index": 0}]]
    },
    "Validate Booking Event": {
      "main": [
        [{"node": "Acknowledge Event", "type": "main", "index": 0}],
        [{"node": "Reject Invalid Event", "type": "main", "index": 0}]
      ]
    }
  },
  "active": false,
  "settings": {},
  "versionId": "appointment-ops-starter-v1",
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": []
}
